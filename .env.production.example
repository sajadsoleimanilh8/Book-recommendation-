# Production environment template. Copy to .env on the production host and
# fill in every REPLACE_ME value — .env is gitignored, so this file is the
# only record of what has to be set. The dev-shaped .env.example beside this
# one is not a starting point for this file: every value here is deliberately
# different, because a production value that happens to match a development
# default is exactly what `core.config.production_problems()` refuses to boot
# with (ENV=production fails fast if POSTGRES_PASSWORD or REDIS_PASSWORD is
# still "digikitab_dev", or if REDIS_PASSWORD is empty, or if DEBUG is on).
#
# There is no production host to deploy this onto yet (item 5's note still
# holds: the server itself hasn't been bought). This file is the checklist
# for when there is one, kept accurate against core/config.py and
# docker-compose.yml rather than written once and left to drift.

# --- Runtime ----------------------------------------------------------------
ENV=production
DEBUG=false

# Loopback on purpose, even here (OI-5/OI-3). This app has no authentication
# on every route, so "there is a firewall" is not the mitigation it looks
# like — the intended shape is a reverse proxy (nginx, Caddy, a managed load
# balancer) on the same host, terminating TLS and forwarding to this address.
# Widen only if the proxy genuinely runs on a different host, and then widen
# to that host's private network, never 0.0.0.0 on a publicly reachable one.
HOST=127.0.0.1
PORT=8000

# Not read by the app itself today — logging is hardcoded to INFO in
# main.py's own `logging.basicConfig` call. Carried here for parity with the
# dev file and because it is the obvious place an operator would look to
# change it; wiring it up is a separate, small piece of work, not assumed
# done by this file existing.
LOG_LEVEL=INFO

# Which interface `docker compose` publishes the datastores on. Same
# reasoning as HOST: widen only onto a private network address, and only if
# the app and the datastores run on different hosts.
BIND_HOST=127.0.0.1

# Cross-origin callers. Empty means none, correct as long as this backend
# keeps serving the frontend itself (OI-5 retired the separate Express
# layer that made this necessary). Set this only if the pages are served
# from a different origin or a CDN in front of them — e.g.
# CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=

# --- Trusted proxy (F-55) ----------------------------------------------------
# Empty is the secure default — `X-Forwarded-For` is ignored outright, and
# every caller's rate-limit bucket is keyed on the proxy's own address
# (wrong once a real proxy is in front, but never exploitable). Set this to
# the reverse proxy's own address — the one TCP peer this app will actually
# see — never to a public range and never to "*". A CIDR is accepted
# (10.0.0.0/24), not only a single host, for a proxy tier with more than one
# front-end address.
#
# REQUIRED alongside this: launch uvicorn with `--proxy-headers
# --forwarded-allow-ips=<same value as TRUSTED_PROXY_CIDR>` if running via
# `uvicorn main:app` directly or through scripts/run.ps1 (which passes extra
# arguments through). Running via `python main.py` needs no extra flags —
# main.py's own `uvicorn.run()` call reads TRUSTED_PROXY_CIDR and passes
# `proxy_headers`/`forwarded_allow_ips` itself, driven by this same value.
# Both paths exist because this one setting has two independent
# consumers: core.ratelimit.client_ip() (who is the caller, for rate
# limiting) and uvicorn's own scheme/host detection (whether the original
# request was HTTPS, for redirects and secure cookies). Name the same proxy
# address in both, but neither depends on the other being set.
TRUSTED_PROXY_CIDR=REPLACE_WITH_YOUR_REVERSE_PROXYS_ADDRESS_e.g._10.0.0.5/32

# --- Database (docker compose up -d, or a managed Postgres) -----------------
POSTGRES_USER=digikitab
# MUST NOT be "digikitab_dev" — ENV=production refuses to start otherwise.
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
# The actual database host. 127.0.0.1 only if Postgres runs on this same
# machine (docker-compose's default); a managed database or a separate
# database host goes here instead.
POSTGRES_HOST=REPLACE_WITH_YOUR_DATABASE_HOST
# 5433 in development avoids colliding with another project on the same
# workstation (F-24) — a dedicated production host has no such collision,
# so 5432 (Postgres's own default) is the realistic value here. Keep
# POSTGRES_PORT and DATABASE_URL (if set explicitly) in agreement.
POSTGRES_PORT=5432
POSTGRES_DB=digikitab
# Only needed if the pieces above do not describe the real connection (a
# managed database with its own connection string shape, a non-default
# sslmode, …). Leave unset to have it built from the fields above.
# DATABASE_URL=

DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Redis --------------------------------------------------------------
# MUST NOT be "digikitab_dev" and MUST NOT be empty — either one refuses a
# production boot. Generate the same way as POSTGRES_PASSWORD, with a
# different value.
REDIS_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_RANDOM_PASSWORD
# Host port docker-compose publishes Redis on (6380, not 6379, for the same
# shared-machine reason as POSTGRES_PORT's 5433). Note that REDIS_URL's
# built-in default does not read this — it assumes 6380 — so a different
# port here needs REDIS_URL set explicitly to match.
REDIS_PORT=6380
# Leave unset to have it built from REDIS_PASSWORD; set explicitly only for
# a managed Redis or a non-default host/port.
# REDIS_URL=

# --- AI Librarian (F-22, extended 2026-10-06 for Claude) ---------------
# With a key set here, Claude is primary and Ollama is not used at all —
# nothing below this block needs to be true in that case. Leave empty to
# run the original local-only chain (qwen2.5 via Ollama) unchanged; a
# production host with no GPU should set this.
# Shape: sk-ant-api03-...
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY

# Optional overrides — the code's own defaults already match these exactly;
# uncomment only to pin a different model. The primary also asks for
# Anthropic's server-side refusal fallback (`fallbacks: "default"`), so a
# safety-classifier decline is re-run on a suitable model inside the same
# call; there is nothing to configure for that here.
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_FALLBACK_MODEL=claude-haiku-4-5
# Thinking counts toward this cap even when its text is not returned, so it
# is sized for thinking plus the reply, not the reply alone.
# CLAUDE_MAX_TOKENS=16000

# Only consulted when ANTHROPIC_API_KEY above is empty. A production host
# running the local chain needs Ollama installed and these models pulled,
# the same requirement as any development machine running it.
# LLM_MODEL=qwen2.5:7b
# LLM_FALLBACK_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# How many chat requests may be inside the model at once (section 12's
# degrade-not-queue-forever guard). 2 is tuned for one shared GPU; raise it
# only with more GPU capacity to actually back it.
# LLM_MAX_CONCURRENCY=2
# LLM_QUEUE_WAIT=5.0

# --- Workers ----------------------------------------------------------------
# MUST stay 1 (or unset). This app keeps an in-process job registry (audiobook
# generation, upload ingest), so a second worker would 404 roughly half of all
# job polls — core/jobs.check_single_worker() refuses to start above 1, and
# honours this variable because gunicorn and several hosting platforms set it.
# Scale with a bigger machine, not more workers, until the job registry moves
# out of process.
# WEB_CONCURRENCY=1

# --- Embeddings (semantic search, content similarity) -----------------------
# minilm needs PyTorch and sentence-transformers; lsa runs on numpy alone.
# Changing this changes the vector space, so the stored book vectors must be
# rebuilt for the new backend before search will trust them (F-39).
EMBEDDING_BACKEND=minilm
# auto picks CUDA when torch can see a GPU, else CPU. A production host with
# no GPU runs on CPU — workable for encoding search queries, slow and hot for
# a full re-embedding pass; set cuda explicitly only on a host that has one.
# EMBEDDING_DEVICE=auto
# EMBEDDING_CPU_THREADS=
# EMBEDDING_BATCH=64

# Reported as the ranking model's version (recommendation logs, /health).
# Defaults to rec-6.0.0+<EMBEDDING_BACKEND>; override only to tag a deploy.
# MODEL_VERSION=

# --- Catalogue enrichment (Phase 2) -----------------------------------------
# Shape: AIza...
GOOGLE_BOOKS_API_KEY=REPLACE_WITH_YOUR_GOOGLE_BOOKS_API_KEY

# --- Auth ---------------------------------------------------------------
# REQUIRED — ENV=production refuses to boot with this empty (unlike
# development, which generates and persists one locally; doing that in
# production would mint a different secret per worker/restart and log out
# every session on each deploy). Generate exactly this way — the command
# core/config.py's own error message gives when this is missing:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

JWT_EXPIRE_MINUTES=10080

# --- Catalogue ------------------------------------------------------------
CATALOGUE_LANGUAGES=en

# Advanced / rarely overridden — the defaults resolve relative to the
# backend's own install location, which is correct unless the catalogue
# file or audio output directory needs to live somewhere else (a mounted
# volume, a different disk).
# CATALOGUE_PATH=
# AUDIO_DIR=
# BOOK_LOAD_LIMIT=0
