# Copy to .env and fill in. .env is gitignored — never commit real values.

# Google Books API — used in Phase 2 to backfill the catalogue's
# missing descriptions (see docs/PHASE-0-AUDIT.md, F-15).
GOOGLE_BOOKS_API_KEY=

# Runtime
# HOST is loopback on purpose (OI-5). Widening it is a deliberate act: the
# app has no authentication on every route, and Docker publishes past the
# host firewall, so "it is only on my network" is not the mitigation it reads
# as. ENV=production refuses to boot while any credential below is still the
# development default.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
ENV=development

# Which interface `docker compose` publishes the datastores on. Same
# reasoning as HOST; both were 0.0.0.0 until OI-5.
BIND_HOST=127.0.0.1

# Cross-origin callers. Empty means none, which is correct now that the
# backend serves the frontend itself (OI-5 retired the Express layer). Set
# this only if you are serving the pages from somewhere else.
CORS_ORIGINS=

# --- Database (docker compose up -d) ---
# Host port 5433, not 5432 — this project shares a machine with other work.
POSTGRES_USER=digikitab
POSTGRES_PASSWORD=digikitab_dev
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=digikitab

# --- Redis ---
# Redis had no password at all until OI-5, on a port published to every
# interface. This value must match docker-compose.yml's default, and
# REDIS_URL is derived from it unless you override the URL outright.
REDIS_PASSWORD=digikitab_dev
# REDIS_URL=redis://:digikitab_dev@127.0.0.1:6380/0

# --- Local LLM (the AI Librarian, F-22) ---
# How many chat requests may be inside the model at once. Two, because
# Ollama serialises work on one GPU and a third concurrent request adds
# latency without adding throughput. Past capacity a caller falls through to
# the deterministic classifier rather than queueing (section 12).
LLM_MAX_CONCURRENCY=2
LLM_QUEUE_WAIT=5.0

# --- Auth ---
# REQUIRED when ENV=production; auto-generated per-process in development.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Catalogue ---
# OI-2: English-only. Other languages stay in the DB, filtered at query time.
CATALOGUE_LANGUAGES=en
